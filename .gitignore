# Build output.
node_modules/
dist/
dist-ssr/
src-tauri/target/
coverage/
.vite/

# Generated by tauri-build from tauri.conf.json and the capability files on
# every build. Committing it means reviewing a diff nobody wrote.
src-tauri/gen/

# Downloaded by scripts/fetch-ffmpeg.mjs at packaging time. Around 90 MB of
# binaries that are pinned to no revision here on purpose: each release picks
# up the current FFmpeg release line rather than one frozen in this repository.
src-tauri/bin/

# logo.png and src-tauri/icon-source.png are the artwork every icon size is
# rendered from, and src-tauri/icons/ is that render. Both are tracked: the
# taskbar icon is part of the product, not a build artefact.

# Local editor and OS noise.
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.local
.DS_Store
